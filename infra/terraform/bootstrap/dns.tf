# ---------------------------------------------------------------------------
# Route 53 ホストゾーン
#
# ドメインは利用者が各自で用意する（レジストラは問わない）。
# ここでは Route 53 側のゾーンだけを作り、出力された NS レコード 4 本を
# ドメインを管理している側へ登録してもらう。
#
#   サブドメインを委譲する場合  親ゾーンの DNS に NS レコードを 4 本追加する
#   ドメイン全体を引く場合      レジストラのネームサーバー設定を 4 本へ変更する
#
# 本体（infra/terraform）は data source でこのゾーンを引くため、
# 委譲が済む前に apply すると ACM の DNS 検証で止まる。先にこちらを済ませる。
# ---------------------------------------------------------------------------

resource "aws_route53_zone" "main" {
  name    = var.dns_zone_name
  comment = "${var.project} (delegated)"

  # 作り直すと NS が変わり、ドメイン側の再登録が必要になるため保護する
  lifecycle {
    prevent_destroy = true
  }
}
