env    = "prod"
region = "ap-northeast-1"

# 配信用と管理画面用のドメイン。
# bootstrap で作成したゾーンに含まれる名前を指定する。
video_domain = "video.example.jp"
admin_domain = "admin.example.jp"

# レコードを親ゾーンへまとめて作る場合のみ指定する。
# 省略時は video_domain / admin_domain 自体をゾーン名として扱う
# （ドメインごとに委譲した構成）。
# video_zone_name = "example.jp"
# admin_zone_name = "example.jp"

alert_email = "admin@example.jp"

# CloudFront Signed URL 用の公開鍵。先に鍵ペアを生成する。
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -pubout -in private_key.pem -out public_key.pem
# 秘密鍵は Terraform へ渡さず、Secrets Manager へ CLI で投入する。
#
# ファイルを指定する方法（推奨。貼り付けミスが起きない）。
# パスはこのディレクトリからの相対パス。
cloudfront_public_key_path = "../../public_key.pem"

# PEM を直接書く場合は上を消してこちらを使う
# cloudfront_public_key = <<-EOT
#   -----BEGIN PUBLIC KEY-----
#   （公開鍵の内容をそのまま貼る）
#   -----END PUBLIC KEY-----
# EOT

# S3 バケット名の接尾辞。
# 未指定ならアカウント ID が付き、他アカウントと衝突しない名前になる。
#   mimicast-prod-media-123456789012
# bucket_suffix = "123456789012"

# 既定は 64 GiB
max_upload_bytes = 68719476736

# ローカル開発時のみ設定する
# allowed_dev_origins = ["http://localhost:5173"]

monthly_budget_usd           = 50
expected_monthly_transfer_gb = 100
